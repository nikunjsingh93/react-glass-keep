{
  "name": "liquid-keep",
  "private": true,
  "version": "1.0.6",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c auto \"vite\" \"npm:api\"",
    "api": "cross-env NODE_ENV=development API_PORT=8080 node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "tauri": "tauri",
    "native:dev": "vite --config vite.native.config.js",
    "native:build": "vite build --config vite.native.config.js",
    "app:windows": "tauri build",
    "app:android": "tauri android build --apk --target aarch64"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/transformers": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "fflate": "^0.8.3",
    "framer-motion": "^12.43.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.539.0",
    "marked": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.6",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0"
  }
