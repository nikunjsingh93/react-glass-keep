{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glass Keep",
  "version": "1.0.15",
  "identifier": "io.github.nikunjsingh93.glasskeep",
  "build": {
    "beforeDevCommand": "npm run native:dev",
    "devUrl": "http://localhost:1420/native.html",
    "beforeBuildCommand": "npm run native:build",
    "frontendDist": "../dist-native"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glass Keep",
        "url": "native.html",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; connect-src ipc: http://ipc.localhost data: blob:; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
